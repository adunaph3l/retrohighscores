# ==========================================
# RETRO HIGH SCORES - CONFIGURATION (.env)
# ==========================================

# Clé secrète pour les sessions et tokens JWT (changez-la en production)
SECRET_KEY=votre_cle_secrete_ultra_securisee_retro_arcade_2026

# Clé d'API RAWG.io pour la récupération auto des screenshots et jaquettes de jeux
# Obtenez une clé gratuite (50 000 requêtes/mois) sur https://rawg.io/apidocs
RAWG_API_KEY=votre_cle_api_rawg_ici

# URL du Webhook Discord pour les annonces automatiques
# (Début de challenge, nouveau score soumis, fin de challenge et podium)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Identifiants initiaux du compte Administrateur
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin1234